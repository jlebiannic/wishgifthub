# Format systemd EnvironmentFile : NOM=valeur, sans "export".
# Remplacer toutes les valeurs CHANGE_ME avant de démarrer le backend.
SPRING_DATASOURCE_URL=jdbc:postgresql://CHANGE_ME:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=CHANGE_ME
SPRING_DATASOURCE_PASSWORD=CHANGE_ME
WISHGIFTHUB_JWT_SECRET=CHANGE_ME_USE_A_RANDOM_SECRET_OF_AT_LEAST_32_BYTES
WISHGIFTHUB_JWT_EXPIRATION_MS=86400000
WISHGIFTHUB_INVITATION_BASE_URL=http://192.168.0.50/wishgifthub/invite/
