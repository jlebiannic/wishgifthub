[Unit]
Description=WishGiftHub Spring Boot API
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User=wishgifthub
Group=wishgifthub
WorkingDirectory=/opt/wishgifthub/backend
EnvironmentFile=/etc/wishgifthub/.env
Environment=SERVER_ADDRESS=127.0.0.1
Environment=SERVER_PORT=8080
ExecCondition=/usr/local/libexec/wishgifthub-check-env
ExecStart=/usr/bin/java -Xms64m -Xmx256m -XX:+UseSerialGC -jar /opt/wishgifthub/backend/app.jar
Restart=on-failure
RestartSec=15
TimeoutStopSec=45
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
